# Incremental fragment on top of config/base.config (the device's own /proc/config.gz).
# Only container / Docker capability is added here. Everything else stays exactly as
# the ROM shipped it, so builtin WiFi (CONFIG_MTK_COMBO_WIFI), BT (CONFIG_MTK_COMBO_BT),
# display, touch and fingerprint drivers keep their original code and configuration.

# --- SysV IPC: Droidspaces reports "[MUST HAVE] IPC namespace" as missing -----------
# IPC_NS depends on SYSVIPC, so both must be on or olddefconfig silently drops IPC_NS.
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_IPC_NS=y

# --- Namespaces ---------------------------------------------------------------
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
# Needed by unprivileged Docker/Podman, Bubblewrap, Flatpak and desktop sandboxes.
CONFIG_USER_NS=y

# --- cgroup controllers -------------------------------------------------------
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
# --cpus support
CONFIG_CFS_BANDWIDTH=y
# --pids-limit support
CONFIG_CGROUP_PIDS=y
# device cgroup (docker --device)
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y

# --- devtmpfs -----------------------------------------------------------------
# Hardware-access mode in Droidspaces. Do NOT set DEVTMPFS_MOUNT: Android mounts
# its own tmpfs over /dev and an automatic mount would fight init.
CONFIG_DEVTMPFS=y

# --- Docker networking --------------------------------------------------------
CONFIG_BRIDGE=y
CONFIG_VETH=y
CONFIG_TUN=y
CONFIG_MACVLAN=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
# dockerd's bridge driver hard-fails without addrtype:
#   iptables -m addrtype ... Extension addrtype not supported
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_NETDEV=y

# --- misc container plumbing --------------------------------------------------
CONFIG_POSIX_MQUEUE=y
CONFIG_OVERLAY_FS=y
CONFIG_KEYS=y
CONFIG_CGROUP_NET_PRIO=y
