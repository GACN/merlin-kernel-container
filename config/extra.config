# ---- container support: droidspaces + docker ----
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUP_DEVICE=y
# Keep CGROUP_PIDS and CFS_BANDWIDTH off in the compatibility build.
# They are not required for the container to boot, and changing cgroup
# internals can invalidate prebuilt vendor WiFi/BT module symbol CRCs.
# CONFIG_CGROUP_PIDS is not set
# CONFIG_CFS_BANDWIDTH is not set
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_BLK_CGROUP=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_IP_NF_TARGET_TCPMSS=y
CONFIG_MACVLAN=y
# IPVLAN is deliberately omitted: it is known to break prebuilt wlan.ko
# ABI on 4.14 Android kernels.
CONFIG_VXLAN=y
CONFIG_NET_IPIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_IPV6=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_IPV6=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_INDEX=y
# keep the exact stock vermagic so vendor .ko keep loading.
# Evidence: kernel inside boot.img of miui_MERLIN_V12.5.7.0.RJOCNXM reports
#   "4.14.186-g46ead2c21af1 SMP preempt mod_unload modversions aarch64"
# (a stray vendor.img that said -perf-g6f6f342de0ae belonged to another ROM)
CONFIG_LOCALVERSION="-g46ead2c21af1"
CONFIG_LOCALVERSION_AUTO=n
# Keep the stock MT6768 power/SSPM path enabled. The failed Shas image
# crashed in sspm_reserve_memory_init during early boot after changing this
# baseline and replacing the stock DTB.
CONFIG_MTK_PTPOD=y
CONFIG_MTK_TINYSYS_SSPM_SUPPORT=y
CONFIG_MTK_FREQ_HOPPING=y
# KernelSU (only applied on the ksu build variant)
# CONFIG_KSU=y
