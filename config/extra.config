# ---- container support: droidspaces + docker ----
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_BLK_CGROUP=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_IP_NF_TARGET_TCPMSS=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_VXLAN=y
CONFIG_NET_IPIP=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_INDEX=y
# keep the exact stock vermagic so vendor .ko keep loading.
# Evidence: strings vendor.img (official V13) -> .modinfo vermagic
#   "4.14.186-perf-g6f6f342de0ae SMP preempt mod_unload modversions aarch64"
CONFIG_LOCALVERSION="-perf-g6f6f342de0ae"
CONFIG_LOCALVERSION_AUTO=n
